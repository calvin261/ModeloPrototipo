<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Producción: cleartext completamente deshabilitado.
        El release apunta solo a https://calvin261-lsec-api.hf.space/.
        Para desarrollo/debug se mantiene un override limitado que permite HTTP
        solo a IPs privadas (192.168.x.x, 10.0.2.x) en builds no-release.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
