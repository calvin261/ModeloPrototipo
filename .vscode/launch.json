{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Backend: FastAPI (uvicorn)",
            "type": "python",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "api.main:app",
                "--host", "0.0.0.0",
                "--port", "8000",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "justMyCode": false,
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            }
        },
        {
            "name": "Backend: start_backend.py",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/backend/start_backend.py",
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            }
        },
        {
            "name": "Train: Classifier",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/backend/scripts/train_classifier.py",
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            }
        },
        {
            "name": "Train: Sequence (LSTM)",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/backend/scripts/train_sequence.py",
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            }
        },
        {
            "name": "Tests: pytest",
            "type": "python",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-q",
                "tests"
            ],
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/.venv/Scripts/python.exe",
            "console": "integratedTerminal",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/backend"
            }
        },
    ],
    "compounds": [
        {
            "name": "Backend + Tests",
            "configurations": [
                "Backend: FastAPI (uvicorn)",
                "Tests: pytest"
            ]
        }
    ]
}
